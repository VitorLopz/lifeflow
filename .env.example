# String de conexão do PostgreSQL (Neon, Railway, Supabase, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/lifeflow?schema=public"

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório longo em produção
JWT_SECRET="troque-por-um-segredo-bem-grande-e-aleatorio"

# Tempo de expiração do token
JWT_EXPIRES_IN="7d"

# Porta da API
PORT=3333

# Domínio do frontend permitido no CORS (separe por vírgula se precisar de mais de um)
CORS_ORIGIN="http://localhost:5173"

# Necessária para o Assistente IA (nunca exponha essa chave no frontend)
ANTHROPIC_API_KEY="sk-ant-..."
